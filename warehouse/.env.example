# Template for warehouse/.env (python-decouple). Copy to warehouse/.env and
# fill in the values marked <secret>. Never commit the real .env.
# Lines left commented use the default shown (see warehouse/settings.py).

# --- Profile and security ---------------------------------------------------------
# PROD on servers, Local on a developer machine (PostgreSQL), anything else = SQLite.
ENV=PROD
SECRET_KEY=<secret>
# DEBUG=False
# ALLOWED_HOSTS=*
# CORS_ORIGIN_ALLOW_ALL=True
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Database ---------------------------------------------------------------------
DB_HOSTNAME=warehouse
DB_USERNAME=<secret>
DB_PASSWORD=<secret>
DB_HOST=localhost
DB_PORT=5432
# Must stay False unless a real "secondary" database is configured
# (wareApp/routers.py would send the load-data tables there).
# USE_SECONDARY_DATABASE=False
# Set only in the MQTT processing systemd units, not here:
# DB_SYNCHRONOUS_COMMIT=off
# Main-server DB, read by roadcast_monthly_refuel_report.py on the test server:
# MAIN_DB_PASSWORD=<secret>
# MAIN_DB_NAME=warehouse
# MAIN_DB_USER=aviconn
# MAIN_DB_HOST=172.31.9.28
# MAIN_DB_PORT=5432

# --- E-mail (alarm e-mails and password-reset OTPs; wareApp/sendmail.py) -------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no.reply@aviconncorp.com
# Gmail app password of EMAIL_HOST_USER.
EMAIL_HOST_PASSWORD=<secret>
DEFAULT_FROM_EMAIL=no.reply@aviconncorp.com
# EMAIL_TIMEOUT=10
# Testing: every alarm e-mail goes only to these addresses (empty = real recipients).
# ALARM_EMAIL_OVERRIDE_TO=ashutosh.dubey@aviconncorp.com
# ALARM_EMAIL_DEFAULT_TO=
# ALARM_FEED_MAX_AGE_DAYS=30
# ALARM_HIGH_CONSUMPTION_DEFAULT_PERCENT=75
# ALARM_ACTIVITY_THRESHOLD_KWH=0.01
# ALARM_REEVALUATE_DAYS=7

# --- Password reset (wareApp/views/auth.py) ----------------------------------------
# PASSWORD_RESET_OTP_MINUTES=10
# True = forgot/ also returns the OTP in its response (old clients only).
# PASSWORD_RESET_RETURN_OTP=False
# PASSWORD_RESET_RATE=10/hour

# --- DG fuel providers (wareApp/fuel_providers.py) --------------------------------
# Empty = that provider's pull is skipped.
ROADCAST_PULL_USERNAME=<secret>
ROADCAST_PULL_PASSWORD=<secret>
LOCONAV_API_TOKEN=<secret>

# --- Cache, Celery, logging -------------------------------------------------------
# REDIS_URL=
# LOCMEM_CACHE_MAX_ENTRIES=200000
# CELERY_BROKER_URL=amqp://guest@localhost//
# CELERY_RESULT_BACKEND=rpc://
# DEBUG_LOG_LEVEL=INFO

# --- MQTT pipeline ----------------------------------------------------------------
# MQTT_BROKER_HOST=127.0.0.1
# MQTT_BROKER_PORT=1883
# MQTT_QUEUE1_CLIENT_ID=server_paho_client_1
# MQTT_QUEUE2_CLIENT_ID=server_paho_client_2
# MQTT_SITE_PARTITIONS=0
# MQTT_CONSUMPTION_BATCH_SECONDS=60
# MQTT_IDEMPOTENCY_TTL_SECONDS=21600
# MQTT_RECOVERY_REQUEST_COOLDOWN_SECONDS=600
# MQTT_RECOVERY_MAX_ATTEMPTS=3
# MQTT_RECOVERY_FAILED_RETRY_SECONDS=21600
# MQTT_SYNC_LATE_SECONDS=4200
# MQTT_SYNC_MISSING_SECONDS=7800
# MQTT_TRANSIENT_MESSAGES=True
# MQTT_ASYNC_NOTIFICATIONS=True

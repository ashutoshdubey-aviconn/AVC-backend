        device1 = FireEquipmentsSystem.objects.filter(next_service__month=monthfirstDate.month, next_service__year=monthfirstDate.year)
        if device1.exists():
            for i in device1:
                device.append({"deviceType":i.deviceType.devicename,"modelNo":i.modelNo,
                               "loaction":i.loaction,"last_service":i.last_service, "next_service":i.next_service})
            print(device)

        else:
            pass
    else:
        oneWeekBefore = FireEquipmentsSystem.objects.filter(next_service=oneWeekBeforDate.date())
        if oneWeekBefore:
            for i in oneWeekBefore:
                pass
        else:
            print("One week before any Service not expired of any device")
        onedayBefore = FireEquipmentsSystem.objects.filter(next_service=onedayAgo.date())
        if onedayBefore.exists:
            for i in onedayBefore:
                pass
        else:
            print("one day before any service was not expired ")
    if len(device) > 0:
        send_email = send_mail_fire_equipments_system(device, "komalbhati8527@gmail.com")
        print("{} mail send Successfully for all devices in starting of the month".format(datetime.now()))



<mxfile host="generate.py"><diagram name="Consumption (live): batch every 60 s" id="02-consumption-live"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="1425" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="2. Consumption (live): batch every 60 s" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Hourly and daily energy per aisle. Packets are parked for up to a minute and written in bulk with exactly the per-packet rules: current hour, new hour, first reading, gap -&gt; recovery request." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="in" value="consumption packet&lt;br&gt;.../in/consumption/..." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="park" value="listener: consumption_batch.enqueue&lt;br&gt;-&gt; mqtt.consumption.batch" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="beat" value="celerybeat 60 s&lt;br&gt;flush_consumption_batch" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="drain" value="flush(): drain queue&lt;br&gt;(up to 20 000 packets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="dup" value="same packet in&lt;br&gt;last 6 h?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="425" width="240" height="80" as="geometry"/></mxCell><mxCell id="skipdup" value="skipped: duplicate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="parse" value="parse payload&lt;br&gt;ERROR!!! -&gt; meter&lt;br&gt;reading issue alarm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="530" width="210" height="64" as="geometry"/></mxCell><mxCell id="load" value="load aisles, hourly&lt;br&gt;rows (2 days), daily&lt;br&gt;rows: 3 queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="cur" value="current hour&lt;br&gt;row exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="740" width="240" height="80" as="geometry"/></mxCell><mxCell id="upd" value="hour = gateway&#x27;s&lt;br&gt;Current_hour_total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="210" height="64" as="geometry"/></mxCell><mxCell id="prev" value="previous hour&lt;br&gt;row exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="845" width="240" height="80" as="geometry"/></mxCell><mxCell id="newh" value="finish previous hour&lt;br&gt;(total + saving),&lt;br&gt;create new hour row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="950" width="210" height="64" as="geometry"/></mxCell><mxCell id="first" value="any reading&lt;br&gt;ever?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="775" y="950" width="240" height="80" as="geometry"/></mxCell><mxCell id="firstrow" value="first reading:&lt;br&gt;create hour + day rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="950" width="210" height="64" as="geometry"/></mxCell><mxCell id="gap" value="gap: request&lt;br&gt;recovery (flow 4)&lt;br&gt;packet dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1055" width="210" height="64" as="geometry"/></mxCell><mxCell id="day" value="day total = sum of&lt;br&gt;the day&#x27;s hourly rows&lt;br&gt;saving = baseline - total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1055" width="210" height="64" as="geometry"/></mxCell><mxCell id="newday" value="new day?&lt;br&gt;-&gt; yesterday&#x27;s alarms&lt;br&gt;(flow 9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="210" height="64" as="geometry"/></mxCell><mxCell id="bulk" value="bulk_update / bulk_create&lt;br&gt;one statement per table&lt;br&gt;BULK lines in log" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1265" width="210" height="64" as="geometry"/></mxCell><mxCell id="healthy" value="m
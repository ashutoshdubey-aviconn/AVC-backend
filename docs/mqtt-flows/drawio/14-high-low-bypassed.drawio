<mxfile host="generate.py"><diagram name="High / Low Consumption and Bypassed alarms (detail)" id="14-high-low-bypassed"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="14. High / Low Consumption and Bypassed alarms (detail)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="One completed day of one aisle is compared with that aisle&#x27;s own daily baseline. Bypassed &gt;= 100 %, High &gt;= 75 %, Low below a site-set %. Example: UCB-F2, baseline 127.16 kWh: 121.5 kWh -&gt; High, 202.3 kWh -&gt; Bypassed." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="t1" value="Trigger 1: first packet of a&lt;br&gt;new day -&gt; checks YESTERDAY&lt;br&gt;consumption_batch alarm_days" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="t2" value="Trigger 2: recovery reply&lt;br&gt;rewrote past days (&lt;= 7)&lt;br&gt;evaluate_days()" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="t3" value="Trigger 3: manual&lt;br&gt;replay_consumption_alarms&lt;br&gt;--from --to [--apply]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="read" value="DailySiteReading of the aisle&lt;br&gt;consumption = sum of the&lt;br&gt;day&#x27;s hourly rows" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="eval" value="evaluate_daily_alarms&lt;br&gt;(site, aisle, daily row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="base" value="baseline for the day?&lt;br&gt;baseline_info(): SiteBaseline&lt;br&gt;(dated row, else newest)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="425" width="240" height="80" as="geometry"/></mxCell><mxCell id="none" value="no alarm&lt;br&gt;(no baseline, or day&lt;br&gt;before baseline start)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="bthr" value="bypass threshold =&lt;br&gt;site.bypass_consumption_units&lt;br&gt;else baseline x 100 %&lt;br&gt;(ALARM_BYPASS_DEFAULT_PERCENT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="530" width="210" height="64" as="geometry"/></mxCell><mxCell id="byp" value="consumption &gt;=&lt;br&gt;bypass threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="635" width="240" height="80" as="geometry"/></mxCell><mxCell id="rbyp" value="BYPASSED (11)&lt;br&gt;saved nothing that day&lt;br&gt;-&gt; stop (High not checked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="210" height="64" as="geometry"/></mxCell><mxCell id="hthr" value="high threshold =&lt;br&gt;site.high_consumption_units&lt;br&gt;else baseline x 75 %&lt;br&gt;(site % or ALARM_HIGH_..._PERCENT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="740" width="210" height="64" as="geometry"/></mxCell><mxCell id="high" value="consumption &gt;=&lt;br&gt;high threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="845" width="240" height="80" as="geometry"/></mxCell><mxCell id="rhigh" value="HIGH CONSUMPTION (7)&lt;br&gt;(75 % .. 100 % of baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="845" width="210" height="64" as="geometry"/></mxCell><mxCell id="low" value="site.min_threshold_value&lt;br&gt;set (X %)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="950" width="240" height="80" as="geometry"/></mxCell><mxCell id="nolow" value="Low not checked&lt;br&gt;(opt-in only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="950" width="210" height="64" as="geometry"/></mxCell><mxCell id="lowc" value="consumption &lt;&lt;br&gt;baseline x (1 - X %)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="1055" width="240" height="80" as="geometry"/></mxCell><mxCell id="rlow" value="LOW CONSUMPTION (8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1055" width="210" height="64" as="geometry"/></mxCell><mxCell id="ok" value="no alarm for this day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1055" width="210" height="64" as="geometry"/></mxCell><mxCell id="rec" value="_record(): alarm for this&lt;br&gt;aisle + type + day exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="1160" width="240" height="80" as="geometry"/></mxCell><mxCell id="dupe" value="skip: no new row,&lt;br&gt;no e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="210" height="64" as="geometry"/></mxCell><mxCell id="store" value="AlarmNotifications&lt;br&gt;Alarm_type 7 / 8 / 11, aisle, leg,&lt;br&gt;created_time = day, to_do = reason" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1265" width="210" height="64" as="geometry"/></mxCell><mxCell id="notify" value="notify(send_alarm_email)&lt;br&gt;after commit -&gt; notifications&lt;br&gt;queue (direct if queue down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1370" width="210" height="64" as="geometry"/></mxCell><mxCell id="mail" value="e-mail &#x27;[Alarm] - [site]&#x27;&lt;br&gt;aisle, leg, date, consumption,&lt;br&gt;baseline, threshold&lt;br&gt;(test: override address only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="1370" width="210" height="64" as="geometry"/></mxCell><mxCell id="feed" value="alarm_feed.active_alarms()&lt;br&gt;1 row per aisle + type, 30 days&lt;br&gt;alarmTypeApi / alarmapi" style="rounded=1;whiteSpace=wrap;htm
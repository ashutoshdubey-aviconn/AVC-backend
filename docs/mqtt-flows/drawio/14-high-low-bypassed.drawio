ry relative="1" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;Files and functions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/services/consumption_alarms.py&lt;/b&gt;&lt;br&gt;evaluate_daily_alarms, evaluate_days, _bypass_threshold, _high_percent, _record (+ operation_hours_check, see flow 9)&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/services/baseline.py&lt;/b&gt;&lt;br&gt;baseline_info, BaselineMemo&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/consumption_batch.py&lt;/b&gt;&lt;br&gt;alarm_days -&amp;gt; yesterday after the bulk write&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/hourly / daily_consumption_recovery.py&lt;/b&gt;&lt;br&gt;evaluate_days after a recovery&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/management/commands/replay_consumption_alarms.py&lt;/b&gt;&lt;br&gt;manual day-by-day replay&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/services/notifications.py, sendmail.py&lt;/b&gt;&lt;br&gt;notify, send_alarm_email&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/alarm_feed.py&lt;/b&gt;&lt;br&gt;active_alarms (alarm list APIs)&lt;br&gt;&lt;br&gt;&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;ALARM_BYPASS_DEFAULT_PERCENT=100, ALARM_HIGH_CONSUMPTION_DEFAULT_PERCENT=75, ALARM_REEVALUATE_DAYS=7, ALARM_EMAIL_OVERRIDE_TO&lt;br&gt;&lt;br&gt;&lt;b&gt;Site fields (overrides)&lt;/b&gt;&lt;br&gt;bypass_consumption_units, high_consumption_units, high_consumption_baseline_percent, min_threshold_value&lt;br&gt;&lt;br&gt;&lt;b&gt;Models&lt;/b&gt;&lt;br&gt;Site, SiteBaseline, AisleGroup, DailySiteReading, AlarmNotifications&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="360" height="500" as="geometry"/></mxCell><mxCell id="lg0" value="Processing step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1060" y="630" width="170" height="32" as=
<mxfile host="generate.py"><diagram name="Day-end consumption alarms (Bypassed / High / Low / Operation hours) and Meter Reading Issue" id="09-day-end-alarms"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1005" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="9. Day-end consumption alarms (Bypassed / High / Low / Operation hours) and Meter Reading Issue" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Each completed day of each aisle is compared with its own baseline. Bypassed is automatic at 100 %, High at 75 %, Low only where configured." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="t1" value="new day&#x27;s first packet&lt;br&gt;(flow 2)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="t2" value="recovery rewrote past&lt;br&gt;days (flow 5, &lt;= 7 days)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="t3" value="manage.py&lt;br&gt;replay_consumption_alarms" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="eval" value="evaluate_daily_alarms&lt;br&gt;(site, aisle, daily row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="base" value="baseline for&lt;br&gt;the day?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="none" value="no alarm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="byp" value="consumption &gt;= baseline x 100 %&lt;br&gt;(or site bypass kWh)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="425" width="240" height="80" as="geometry"/></mxCell><mxCell id="rbyp" value="Bypassed (11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="210" height="64" as="geometry"/></mxCell><mxCell id="ops" value="NL window set and active&lt;br&gt;hours outside / too many?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="530" width="240" height="80" as="geometry"/></mxCell><mxCell id="rops" value="Operation Hours&lt;br&gt;Increased (12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="530" width="210" height="64" as="geometry"/></mxCell><mxCell id="high" value="consumption &gt;= site high kWh&lt;br&gt;or baseline x 75 %?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="635" width="240" height="80" as="geometry"/></mxCell><mxCell id="rhigh" value="High Consumption (7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strok
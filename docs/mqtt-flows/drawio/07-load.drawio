<mxfile host="generate.py"><diagram name="Load: live load, voltage and power-factor alarms" id="07-load"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="7. Load: live load, voltage and power-factor alarms" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Real-time load and phase values per meter and power source; updates the live table and raises high / low voltage and power-factor alarms." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="in" value="load packet&lt;br&gt;load, R/Y/B volt + current,&lt;br&gt;PF, source, status, meter" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="q" value="queue1_processing" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="parse" value="_parse_load_message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="volt" value="show_voltage_alarms&lt;br&gt;and all phases &gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="425" width="240" height="80" as="geometry"/></mxCell><mxCel
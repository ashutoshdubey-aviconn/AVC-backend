<mxfile host="generate.py"><diagram name="HTTP calls from gateways" id="12-http-from-gateways"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1230" pageHeight="646" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="12. HTTP calls from gateways" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Three things gateways send over HTTP instead of MQTT: bulk recovery uploads, overheat alerts and meter-disconnection events." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="rec" value="POST /api/v1/recovery/upload/&lt;br&gt;&#x27;Recovery Payload&#x27;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="proc" value="process_http_recovery&lt;br&gt;hourly / daily / runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="recdb" value="same tables and recovery&lt;br&gt;status as flows 5, 6" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="heat" value="POST /api/temp/dispatch/mail/&lt;br&gt;CPU &gt;= 85 °C (every ~3 s)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="parse" value="parse_alert:&lt;br&gt;site, gateway, temperature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="store" value="store once / 60 s:&lt;br&gt;AlarmNotifications type 13&lt;br&gt;(1 row per gateway per day)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="mail" value="e-mail &#x27;Gateway Overheat&#x27;&lt;br&gt;once per gateway per hour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="md" value="POST /api/meter-disconnections/&lt;br&gt;ingest/" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="mde" value="MeterDisconnectionEvent&lt;br&gt;(create or update window)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rec" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proc" target="recdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rou
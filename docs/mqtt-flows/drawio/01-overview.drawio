<mxfile host="generate.py"><diagram name="Overview: from gateway to database" id="01-overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="1. Overview: from gateway to database" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Two isolated MQTT listeners receive every gateway packet and only queue it; Celery workers process it in order per site and write the tables. Timers drive the consumption flush and the recovery-status sweep." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="gw" value="Gateway&lt;br&gt;publishes MQTT&lt;br&gt;(QoS 1)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="mosq" value="Mosquitto broker&lt;br&gt;persistent sessions" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="l1" value="Listener queue 1&lt;br&gt;mqtt-listener-queue1&lt;br&gt;run_mqtt_client1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="l2" value="Listener queue 2&lt;br&gt;mqtt-listener-queue2&lt;br&gt;run_mqtt_client2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x=
<mxfile host="generate.py"><diagram name="Recovery request lifecycle (sync requests)" id="04-recovery-lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="4. Recovery request lifecycle (sync requests)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="What happens after a gap is found: the request, retries, failure and the per-aisle sync status, until the gateway&#x27;s reply fills the gap." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="gap" value="live packet finds a gap&lt;br&gt;(consumption / SupplyTime)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="cool" value="cooldown open?&lt;br&gt;(10 min, per aisle/source)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="215" width="240" height="80" as="geometry"/></mxCell><mxCell id="drop" value="packet dropped&lt;br&gt;&#x27;already requested&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="open" value="open RecoveryMonitor&lt;br&gt;for this gap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="max" value="attempts &gt;= 3?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="425" width="240" height="80" as="geometry"/></mxCell><mxCell id="failed" value="status failed&lt;br&gt;no more requests&lt;br&gt;(new try after 6 h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="new" value="create RecoveryMonitor&lt;br&gt;missing_from..to&lt;br&gt;attempt 1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="retry" value="attempt + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="530" width="210" height="64" as="geometry"/></mxCell><mxCell id="pub" value="publish sync request&lt;br&gt;after commit&lt;br&gt;sync_status = recovery_requested" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="reply" value="gateway reply&lt;br&gt;recovery/hourlyConsumption&lt;br&gt;/ dailyConsumption / loadRuntime" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="740" width="210" height="64" as="geometry"/></mxCell><mxCell id="resp" value="record_response&lt;br&gt;(response_received)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="845" width="210" height="64" as="geometry"/></mxCell><mxCell id="apply" value="upsert slots&lt;br&gt;(flows 5, 6)&lt;br&gt;record_applied" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="950" width="210" height="64" as="geometry"/></mxCell><mxCell id="all" value="every missing hour&lt;br&gt;present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="1055" width="240" height="80" as="geometry"/></mxCell><mxCell id="ok" value="recovered -&gt;&lt;br&gt;next packet: healthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="210" height="64" as="geometry"/></mxCell><mxCell id="partial" value="stays open:&lt;br&gt;retried like no answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="1160" width="210" height="64" as="geometry"/></mxCell><mxCell id="sweep" value="sweep every 5 min:&lt;br&gt;no answer after 10 min&lt;br&gt;-&gt; timeout" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="740" width="210" height="64" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gap" target="cool"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cool" target="drop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cool" target="open"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="open" target="new"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="open" target="max"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="max" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="max" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="new" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="retry" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pub" target="reply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reply" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="resp" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="apply" target="all"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="all" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="all" target="partial"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sweep" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;Files and functions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/services/recovery_status.py&lt;/b&gt;&lt;br&gt;RecoveryScope, RecoveryStatusService.request_recovery / record_response / record_applied / _catch_up_slot&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/services/cooldown.py&lt;/b&gt;&lt;br&gt;recovery_request_allowed, release_recovery_request&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/services/publisher.py&lt;/b&gt;&lt;br&gt;MqttPublisher, publish_after_commit&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/sync_status.py&lt;/b&gt;&lt;br&gt;upsert_status, mark_sync_healthy, mark_source_healthy&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/management/commands/recovery_status_sweep.py&lt;/b&gt;&lt;br&gt;sweep(): timeout / failed / late / missing&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/admin.py&lt;/b&gt;&lt;br&gt;AisleSyncRecoveryStatusAdmin, retry recovery action&lt;br&gt;&lt;br&gt;&lt;b&gt;Tables&lt;/b&gt;&lt;br&gt;RecoveryMonitor (history), AisleSyncRecoveryStatus (current state)&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="360" height="362" as="geometry"/></mxCell><mxCell id="lg0" value="Processing step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1060" y="492" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg1" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1240" y="492" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg2" value="Database table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1060" y="532" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg3" value="RabbitMQ queue / MQTT topic" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1240" y="532" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg4" value="Alarm / e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1060" y="572" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg5" value="External: gateway, broker, timer" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1240" y="572" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg6" value="Packet dropped / skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1060" y="612" width="170" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

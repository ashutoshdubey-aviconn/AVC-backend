<mxfile host="generate.py"><diagram name="PF Bad Value (type 2)" id="20-power-factor"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1230" pageHeight="1005" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="20. PF Bad Value (type 2)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="From live load packets with power factors: any phase below the site&#x27;s PF threshold while the source is ON." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="in" value="load packet with&lt;br&gt;R / Y / B power factor" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="row" value="SiteLoadPower row exists&lt;br&gt;(not the first packet)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="215" width="240" height="80" as="geometry"/></mxCell><mxCell id="first" value="first packet: create row,&lt;br&gt;no PF check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="vis" value="site.is_pf_visible and&lt;br&gt;status = ON?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="off" value="no PF check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="thr" value="all three PF thresholds&lt;br&gt;set on the site?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="425" width="240" height="80" as="geometry"/></mxCell><mxCell id="miss" value="skip; warning once per&lt;br&gt;site per hour (sites 124,&lt;br&gt;131, 145, 153, 156 today)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="low" value="any phase PF &lt;&lt;br&gt;its threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="530" width="240" height="80" as="geometry"/></mxCell><mxCell id="pfd" value="PowerFactorData&lt;br&gt;(low phases recorded)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="rec" value="PF alarm for this source&lt;br&gt;e-mailed in last 30 min?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="740" width="240" height="80" as="geometry"/></mxCell><mxCell id="dup" value="skip (30 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="210" height="64" as="geometry"/></mxCell><mxCell id="new" value="AlarmNotifications type 2:&lt;br&gt;today&#x27;s row (+ count)&lt;br&gt;or new row; R/Y/B PF" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=
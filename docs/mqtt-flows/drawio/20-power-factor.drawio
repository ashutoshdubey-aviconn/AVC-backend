;spacingTop=6;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=10;" vertex="1" parent="1"><mxGeometry x="810" y="110" width="360" height="270" as="geometry"/></mxCell><mxCell id="lg0" value="Processing step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="810" y="400" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg1" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="990" y="400" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg2" value="Database table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="810" y="440" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg3" value="RabbitMQ queue / MQTT topic" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="990" y="440" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg4" value="Alarm / e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="810" y="480" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg5" value="External: gateway, broker, timer" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="990" y="480" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg6" value="Packet dropped / skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=9;" vertex="1" parent="1"><mxGeometry x="810" y="520" width="170" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

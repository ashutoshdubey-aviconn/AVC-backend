<mxfile host="generate.py"><diagram name="Alarm catalogue: every alarm type and where it comes from" id="15-alarm-catalogue"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="738" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="15. Alarm catalogue: every alarm type and where it comes from" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Two alarm tables. AlarmNotifications: per aisle / meter / gateway. NewAlarmsNotifications: per site and power source. Each type below has its own detailed flow (14, 16-22)." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c" value="consumption packets&lt;br&gt;+ day change&lt;br&gt;(flows 2, 9)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="g" value="gateway HTTP&lt;br&gt;/api/temp/dispatch/mail/" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="l" value="load packets&lt;br&gt;(flow 7)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="f" value="fetch-fuel-data&lt;br&gt;(DG runs, every 5 min)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="fa" value="FIREALARM packets&lt;br&gt;(flow 8)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="a1" value="AlarmNotifications&lt;br&gt;7 High  8 Low  11 Bypassed&lt;br&gt;12 Operation Hours&lt;br&gt;10 Meter Reading Issue" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="a2" value="AlarmNotifications&lt;br&gt;13 Gateway Overheat" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="n1" value="NewAlarmsNotifications&lt;br&gt;0 High Voltage&lt;br&gt;1 Low Voltage&lt;br&gt;2 PF Bad Value" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="n2" value="NewAlarmsNotifications&lt;br&gt;9 DG Running Without Load&lt;br&gt;6 Fuel Drain" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="fe" value="no alarm row:&lt;br&gt;Email_History +&lt;br&gt;customer e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="feed" value="alarm_feed.active_alarms()&lt;br&gt;one row per issue&lt;br&gt;alarmTypeApi / alarmapi /&lt;br&g
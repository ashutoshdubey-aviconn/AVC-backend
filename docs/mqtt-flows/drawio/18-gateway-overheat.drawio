<mxfile host="generate.py"><diagram name="Gateway Overheat (Alarm type 13)" id="18-gateway-overheat"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1230" pageHeight="1005" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="18. Gateway Overheat (Alarm type 13)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="The gateway&#x27;s temperature monitor posts over HTTP every ~3 s while its CPU is at or above 85 °C." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="in" value="POST /api/temp/dispatch/mail/&lt;br&gt;Site Id, Gateway No,&lt;br&gt;Gateway Info: Temperature,&lt;br&gt;CPU Status, Fan PWM" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="thr" value="rate limit 60 / min&lt;br&gt;per client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="parse" value="parse_alert: valid body&lt;br&gt;and known site?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="bad" value="400 rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="st" value="stored for this gateway&lt;br&gt;in last 60 s?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="425" width="240" height="80" as="geometry"/></mxCell><mxCell id="throt" value="200 &#x27;throttled&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="today" value="alarm for this gateway&lt;br&gt;already today?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="530" width="240" height="80" as="geometry"/></mxCell><mxCell id="upd" value="update last_seen,&lt;br&gt;occurrences + 1,&lt;br&gt;latest temperature" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="new" value="AlarmNotifications type 13&lt;br&gt;object_type gateway,&lt;br&gt;object_id = gateway no." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="hour" value="e-mailed for this gateway&lt;br&gt;in the last hour?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="740" width="240" height="80" as="geometry"/></mxCell><mxCell id="mail" value="e-mail &#x27;Gateway Overheat&#x27;&lt;br&gt;CPU °C, frequencies, fan&lt;br&gt;(not sent -&gt; retry next alert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="845" width="210" height="64" as="geometry"/></mxCell><mxCell id="e0" value=
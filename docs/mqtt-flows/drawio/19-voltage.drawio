<mxfile host="generate.py"><diagram name="High / Low Voltage (type 0 / 1)" id="19-voltage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1005" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="19. High / Low Voltage (type 0 / 1)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="From live load packets: every reading is kept; an alarm needs five consecutive readings outside the site&#x27;s phase thresholds." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="in" value="load packet&lt;br&gt;R / Y / B volt, source, meter" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="on" value="site.show_voltage_alarms&lt;br&gt;and all phases &gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="215" width="240" height="80" as="geometry"/></mxCell><mxCell id="off" value="no voltage check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="store" value="store reading twice:&lt;br&gt;SiteLoadParameters&lt;br&gt;type 0 (high), type 1 (low)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell id="seven" value="at least 7 readings&lt;br&gt;for this source + type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="425" width="240" height="80" as="geometry"/></mxCell><mxCell id="wait" value="wait for more&lt;br&gt;readings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="five" value="latest 5 readings ALL have a&lt;br&gt;phase &gt; max (high) or&lt;br&gt;&lt; min (low) threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="530" width="240" height="80" as="geometry"/></mxCell><mxCell id="no" value="no alarm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="rec" value="same alarm for this source&lt;br&gt;e-mailed in last 30 min?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="635" width="240" height="80" as="geometry"/></mxCell><mxCell id="dup" value="skip (30 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="new" value="AlarmNotifications 0 / 1:&lt;br&gt;today&#x27;s row (+ count)&lt;br&gt;or new row; R/Y/B values" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="740" width="210" height="64" as="geometry"/></mxCell><mxCell id="mail" value="e-mail high / low voltage&lt;br&gt;(send_alarm_for_high_voltage /&lt;br&gt;send_alarm_for_low_voltage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="845" width="210" height="64" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in" target="on"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="on" target="off"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="on" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="store" target="seven"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seven" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seven" target="five"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="five" target="no"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;l
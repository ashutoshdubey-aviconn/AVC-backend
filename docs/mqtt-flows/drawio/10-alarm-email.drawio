<mxfile host="generate.py"><diagram name="Alarm e-mail pipeline" id="10-alarm-email"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1230" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="10. Alarm e-mail pipeline" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Every alarm e-mail goes through the notifications queue to its own worker, so a slow mail server never blocks MQTT processing." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="alarm" value="alarm stored by a handler&lt;br&gt;(flows 7, 8, 9, 12)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="rep" value="repeat within tolerance of&lt;br&gt;the last e-mailed value?&lt;br&gt;(alarm_policy.should_email)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="215" width="240" height="80" as="geometry"/></mxCell><mxCell id="quiet" value="counted on the alarm,&lt;br&gt;no e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="notify" value="notify(send_function, args)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="commit" value="after the DB commit:&lt;br&gt;queue available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="q" value="notifications queue&lt;br&gt;(persistent)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="direct" value="send directly&lt;br&gt;(fallback, logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="425" width="210" height="64" as="geometry"/></mxCell><mxCell id="worker" value="mqtt-notifications&lt;br&gt;send_notification&lt;br&gt;(allow-listed functions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="210" height="64" as="geometry"/></mxCell><mxCell id="send" value="sendmail.[function]&lt;br&gt;-&gt; _send_smtp_email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="635" width="210" height="64" as="geometry"/></mxCell><mxCell id="over" value="ALARM_EMAIL_OVERRIDE_TO&lt;br&gt;set?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="740" width="240" height="80" as="geometry"/></mxCell><mxCell id="test" value="only to override address&lt;br&gt;(+ &#x27;TEST REDIRECT&#x27; banner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="210" height="64" as="geometry"/></mxCell><mxCell id="real" value="software team (all sites)&lt;br&gt;+ site&#x27;s ground team&lt;br&gt;(AlarmRecipient, AlarmSetting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="845" width="210" height="64" as="geometry"/></mxCell><mxCell id="smtp" value="SMTP (EMAIL_* in .env)&lt;br&gt;&#x27;Email sent&#x27; / &#x27;Email failed&#x27;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="950" width="210" height="64" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alarm" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rep" target="quiet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="no / first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rep" target="notify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="notify" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="commit" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="commit" target="direct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="send"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="direct" target="send"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="send" target="over"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="over" target="test"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="over" target="real"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="test" target="smtp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="real" target="smtp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;Files and functions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/alarm_policy.py&lt;/b&gt;&lt;br&gt;recipients, setting / mode / manual_threshold, should_email, decide_email&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/mqtt/services/notifications.py&lt;/b&gt;&lt;br&gt;notify, ALLOWED_NOTIFICATIONS, QUEUE_ERRORS fallback&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/tasks.py&lt;/b&gt;&lt;br&gt;send_notification (retries 5x on exceptions)&lt;br&gt;&lt;br&gt;&lt;b&gt;wareApp/sendmail.py&lt;/b&gt;&lt;br&gt;_send_smtp_email, _smtp_config, send_alarm_email, send_alarm_for_high/low_voltage, send_mail_for_pf_fluctuation, send_mail_fire_alarm_user&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin tables&lt;/b&gt;&lt;br&gt;AlarmRecipient (Software / Ground team, ground sites), AlarmSetting (per site + type: Auto / Manual / Off, threshold, groups, tolerance)&lt;br&gt;&lt;br&gt;&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;ALARM_REPEAT_TOLERANCE_PERCENT, ALARM_REPEAT_CLEAR_HOURS, ALARM_EMAIL_OVERRIDE_TO, ALARM_EMAIL_DEFAULT_TO (until recipients exist), MQTT_ASYNC_NOTIFICATIONS, EMAIL_*&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=10;" vertex="1" parent="1"><mxGeometry x="810" y="110" width="360" height="316" as="geometry"/></mxCell><mxCell id="lg0" value="Processing step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="810" y="446" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg1" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="990" y="446" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg2" value="Database table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="810" y="486" width="170" height="32" as="geometry"/></mxCell><mxCell id="lg3" value="RabbitMQ queue / MQTT topic" style="shape=parallelogram;perimeter=parallelogramPerimeter;w
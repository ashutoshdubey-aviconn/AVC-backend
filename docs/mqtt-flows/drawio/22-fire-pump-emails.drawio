<mxfile host="generate.py"><diagram name="Fire pump e-mails (FIREALARM, no alarm row)" id="22-fire-pump-emails"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1230" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="22. Fire pump e-mails (FIREALARM, no alarm row)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Panel mode changes and motor-on events, decoded from the three phase voltages; e-mailed to the site&#x27;s customer and logged in Email_History." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="in" value="FIREALARM packet&lt;br&gt;meter, R / Y / B volt,&lt;br&gt;power status" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="rec" value="FirePumpAlarm row&lt;br&gt;for this meter?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="215" width="240" height="80" as="geometry"/></mxCell><mxCell id="skip" value="skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="210" height="64" as="geometry"/></mxCell><mxCell id="keep" value="keep previous volts,&lt;br&gt;update FirePumpAlarm" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="210" height="64" as="geometry"/></mxCell><mxCell
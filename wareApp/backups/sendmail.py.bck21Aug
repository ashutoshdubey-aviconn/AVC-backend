def send_mail_fire_alarm_user(email, alarm_type, device_type, motor_status=0):
    date = timezone.now().strftime("%b %d,%Y %H:%M:%S")
    subject = "Aviconn IOT System Notification - Change in Status"
    html = f"<html><body>Dear Customer,<br>Mode changed: {alarm_type} at {date}.<br>...</body></html>"
    smtp_send_mail(subject, html, settings.EMAIL_HOST_USER,
                   ["abhishek.mehra@aviconncorp.com"],
                   cc=["komal.bhati@aviconncorp.com", "mandeep.kahlon@aviconncorp.com"])
    return True


def emailcheck(id, username, email):
    otp = line(5)
    user = User.objects.get(username=username)
    OTP.objects.create(otp=otp, user_id=user.id)
    date = timezone.now().strftime("%b %d,%Y")
    subject = "Password Change Request for Your Smart Meter Account"
    html = f"<html><body>Dear Customer,<br>Date: {date}. OTP: <b>{otp}</b><br>...</body></html>"
    smtp_send_mail(subject, html, settings.EMAIL_HOST_USER, [email])
    return otp


def send_alarm_for_high_voltage(data):
    site = Site.objects.get(id=data['site_id'])
    colors = {phase: 'red' if int(data[f"{phase}_volts"]) > int(data[f"{phase}_volt_threshold"]) else 'green'
              for phase in ['r', 'y', 'b']}
    html = f"""<html><body><h1>High Voltage Alarm</h1><p>Site: {site.site_name}</p>
    <p style="color:{colors['r']}">R-Phase: {data['r_volts']}</p>
    <p style="color:{colors['y']}">Y-Phase: {data['y_volts']}</p>
    <p style="color:{colors['b']}">B-Phase: {data['b_volts']}</p>
    </body></html>"""
    smtp_send_mail("High Voltage Alarm Testing", html, settings.EMAIL_HOST_USER,
                   ["abhishek.mehra@aviconncorp.com", "mandeep.kahlon@aviconncorp.com"])
    return True


def send_alarm_for_low_voltage(data):
    site = Site.objects.get(id=data['site_id'])
    colors = {phase: 'red' if int(data[f"{phase}_volts"]) < int(data[f"{phase}_volt_threshold"]) else 'green'
              for phase in ['r', 'y', 'b']}
    html = f"""<html><body><h1>Low Voltage Alarm</h1><p>Site: {site.site_name}</p>
    <p style="color:{colors['r']}">R-Phase: {data['r_volts']}</p>
    <p style="color:{colors['y']}">Y-Phase: {data['y_volts']}</p>
    <p style="color:{colors['b']}">B-Phase: {data['b_volts']}</p>
    </body></html>"""
    smtp_send_mail("Low Voltage Alarm Testing", html, settings.EMAIL_HOST_USER,
                   ["abhishek.mehra@aviconncorp.com", "mandeep.kahlon@aviconncorp.com"])
    return True



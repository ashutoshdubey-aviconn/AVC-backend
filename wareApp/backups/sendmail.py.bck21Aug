import os
import random
import smtplib
from datetime import datetime
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText

from django.template.loader import render_to_string
from django.utils import timezone

from warehouse import settings
from wareApp.models import OTP, User, Site


def smtp_send_mail(subject, html_content, from_email, to_emails, cc=None, bcc=None):
    msg = MIMEMultipart("alternative")
    msg["Subject"] = subject
    msg["From"] = from_email
    msg["To"] = ", ".join(to_emails)
    recipients = list(to_emails)
    if cc:
        msg["Cc"] = ", ".join(cc)
        recipients += cc
    if bcc:
        recipients += bcc

    msg.attach(MIMEText(html_content, "html"))

    with smtplib.SMTP(settings.EMAIL_HOST, settings.EMAIL_PORT) as server:
        if getattr(settings, "EMAIL_USE_TLS", False):
            server.starttls()
        server.login("no.reply@aviconncorp.com", "fnrv wpyz ofed gkgc")
        #server.login(settings.EMAIL_HOST_USER, settings.EMAIL_HOST_PASSWORD)
        server.sendmail(from_email, recipients, msg.as_string())


def line(size, li=range(10)):
    return ''.join(str(random.choice(li)) for _ in range(size))


def send_mail_for_sensor_by_pass(site_id, aisle_id, options):
    site = Site.objects.get(id=site_id)
    current_time = timezone.now().strftime("%b %d,%Y %H:%M:%S")
    subject = f"Notification for {site.site_name},{site.location} : Alarm for system By‑Pass"
    html = f"""<html><body>Dear Aviconn Team,<br><p>Alarm detected...</p>Site‑Name: {site.site_name}<br>Location: {site.location}<br>Aisles: {', '.join(aisle_id)}<br>Time: {current_time}<br>...</body></html>"""

    if options == 1:
        smtp_send_mail(subject, html, settings.EMAIL_HOST_USER,
                       ["mandeep.kahlon@aviconncorp.com", "rnd@aviconncorp.com"])
    else:
        smtp_send_mail(subject, html, settings.EMAIL_HOST_USER,
                       ["nidhish.shahi@myntra.Com"],
                       cc=["mandeep.kahlon@aviconncorp.com"],
                       bcc=["manish@aviconncorp.com", "rnd@aviconncorp.com"])
    return True


def send_mail_fire_alarm_aviconn_user(alarm_type):
    date = timezone.now().strftime("%b %d,%Y")
    html = f"<html><body>Dear Customer,<br>Your system is working on {alarm_type} mode at {date}.<br>Sincerely,<br>Aviconn Solution Pvt Ltd</body></html>"
    smtp_send_mail("Fire Alarm Generated", html, settings.EMAIL_HOST_USER,
                   ["komal.bhati@aviconncorp.com", "mandeep.kahlon@aviconncorp.com"])
    return True



                                    baselineList.append(baseline_value)
                        except Exception as e:
                            print('Exception 1 is', e)
                            baseline_value = 0.0
                            baselineList.append(baseline_value)
                dataList.append({"name": "baseline", "data": baselineList, 'type': 'spline'})

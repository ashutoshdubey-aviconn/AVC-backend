                 "next_serviceDate": i.next_service})
            # print("warrenty :",warrentyDeviceList)

        return Response({"status": 200, "totalDevices": totalDevices, "warrenty": warrenty,
                         "expiredDevice": expiredDevice, "data": warrentyDeviceList})



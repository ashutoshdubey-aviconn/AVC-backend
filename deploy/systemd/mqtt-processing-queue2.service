[Unit]
Description=MQTT LoadData processing worker
After=network.target mosquitto.service rabbitmq-server.service postgresql.service
Wants=mosquitto.service rabbitmq-server.service

[Service]
Type=simple
User=ubuntu
Group=sudo
WorkingDirectory=/home/ubuntu/django_project
Environment=DJANGO_SETTINGS_MODULE=warehouse.settings
# Commits do not wait for the WAL flush (see warehouse/settings.py).
Environment=DB_SYNCHRONOUS_COMMIT=off
EnvironmentFile=-/home/ubuntu/django_project/warehouse/.env
ExecStart=/home/ubuntu/django_project/virtualwarehouse/bin/celery -A warehouse worker --hostname=processing.queue2@%%h --queues=queue2_processing --concurrency=1 --prefetch-multiplier=1 --loglevel=INFO
StandardOutput=append:/home/ubuntu/django_project/celerylogs2/celery_logs_of_server.log
StandardError=append:/home/ubuntu/django_project/celerylogs2/celery_logs_of_server.log
Restart=always
RestartSec=10
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target

[Unit]
Description=Alarm email notifications worker
After=network.target mosquitto.service rabbitmq-server.service postgresql.service
Wants=mosquitto.service rabbitmq-server.service

[Service]
Type=simple
User=ubuntu
Group=sudo
WorkingDirectory=/home/ubuntu/django_project
Environment=DJANGO_SETTINGS_MODULE=warehouse.settings
EnvironmentFile=-/home/ubuntu/django_project/warehouse/.env
ExecStart=/home/ubuntu/django_project/virtualwarehouse/bin/celery -A warehouse worker --hostname=notifications@%%h --queues=notifications --concurrency=2 --prefetch-multiplier=1 --loglevel=INFO
StandardOutput=append:/home/ubuntu/django_project/celerylogs1/celery_logs_of_server.log
StandardError=append:/home/ubuntu/django_project/celerylogs1/celery_logs_of_server.log
Restart=always
RestartSec=10
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target
